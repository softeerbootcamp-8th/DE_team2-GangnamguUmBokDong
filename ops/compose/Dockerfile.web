# 운영용 web 이미지 — 정적 번들을 nginx로 서빙한다.
#
# 로컬도 docker-compose.prod.yml을 원본으로 사용하므로 같은 정적 build와 nginx를
# 실행한다. HMR 웹소켓·소스맵·원본 소스가 있는 Vite dev server는 runtime에 쓰지 않는다.
#
# `VITE_API_BASE`는 빌드타임에 번들 문자열로 인라인된다(apps/web/src/api.ts:1).
# 운영에서는 nginx가 /api/를 같은 오리진으로 프록시하므로 절대 URL이 필요 없다 —
# 그래서 기본값을 /api로 두고 api.ts는 손대지 않는다.

FROM node:20-alpine AS build

WORKDIR /app

# 의존성 설치를 소스 COPY보다 먼저 둬서, 소스만 바뀐 재빌드가 npm ci를 건너뛰게 한다.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

# 레포 루트 .dockerignore가 apps/web/node_modules를 제외한다 — 제외하지 않으면
# 호스트(macOS arm64)의 node_modules가 위에서 설치한 alpine용 모듈을 덮어써 깨진다.
COPY apps/web/ ./

ARG VITE_API_BASE=/api
# `npm run build`는 `tsc && vite build`라 타입 에러가 있으면 여기서 실패한다.
RUN VITE_API_BASE=$VITE_API_BASE npm run build


FROM nginx:alpine

COPY ops/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY ops/nginx/dashboard-auth.conf /etc/nginx/snippets/dashboard-auth.conf
COPY --from=build /app/dist /usr/share/nginx/html
