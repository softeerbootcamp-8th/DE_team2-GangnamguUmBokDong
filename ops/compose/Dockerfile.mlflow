# MLflow tracking 서버 이미지 — backend store(postgres)/artifact store(S3 호환
# minio)에 붙어 feature_engine/training/inference 세 인스턴스가 공통으로 실험을
# 기록하는 서버(docker-compose.yml의 mlflow 서비스). `--serve-artifacts`로 띄우므로
# 클라이언트(각 인스턴스)는 MLFLOW_TRACKING_URI만 알면 되고, S3 자격증명은 이
# 컨테이너만 가지고 있으면 된다(artifact 업로드가 클라이언트 대신 이 서버를 거쳐 감).
FROM python:3.11-slim

# 버전을 고정한다. 예전에는 `mlflow`를 핀 없이 깔아서 재빌드 시점의 최신판이
# 들어왔는데, 3.15가 Host 헤더 검증(fastapi_security)을 켜면서 공인 IP로 들어온
# UI 요청이 전부 403이 된 적이 있다(2026-08-24). 트래킹 서버는 실험 기록의
# 재현성을 책임지는 자리라 조용한 자동 업그레이드를 허용하지 않는다.
# 올릴 때는 릴리스 노트를 보고 이 줄을 의도적으로 바꾼다.
RUN pip install --no-cache-dir mlflow==3.15.1 psycopg2-binary boto3

EXPOSE 5000
