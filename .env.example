# 로컬 개발환경 (ops/compose) 설정
# 사용법: cp .env.example .env  (ops/bootstrap/bootstrap.sh가 자동으로 해줌)

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
# 인스턴스 하나에 database 두 개(app, airflow)를 분리해서 사용한다.
POSTGRES_APP_DB=app
POSTGRES_AIRFLOW_DB=airflow

# apps/api, collector, ml/* 등이 앱 데이터베이스에 접근할 때 사용하는 연결 문자열
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_APP_DB}

# --- MinIO (S3 호환 오브젝트 스토리지) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# collector/ml 등이 S3 대신 사용할 엔드포인트 (컨테이너 밖에서 접근 시 localhost 사용)
S3_ENDPOINT_URL=http://localhost:${MINIO_API_PORT}
S3_BUCKET=local-dev
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}

# ml/inference가 LightGBM 모델을 읽어오는 S3 prefix. 로컬에서는 minio-init이
# 레포 루트 ./models/를 이 prefix로 1회 업로드한다(운영에서는 학습 파이프라인이 채움).
MODELS_PREFIX=models

# --- Airflow ---
AIRFLOW_WEBSERVER_PORT=8081
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_AIRFLOW_DB}
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-real-envs

# Airflow 3.x Simple Auth Manager(AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS, docker-compose.yml)가
# 이 사용자명으로 admin 계정을 선언한다. 비밀번호는 Simple Auth Manager가 최초 기동 시
# 자동 생성해 웹서버 로그에 출력한다 (AIRFLOW_ADMIN_PASSWORD는 더 이상 사용되지 않음).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com


# --- 수집 소스 인증키 (collector) ---
# 서울 열린데이터광장 (따릉이 대여이력·실시간 대여정보, 실시간 인구, 생활인구, 문화·공연행사)
# 발급: https://data.seoul.go.kr/together/mypage/actKeyMain.do
SEOUL_OPENAPI_KEY=

# 기상청 API 허브 (초단기 실황·예보, 단기예보)
# 발급: https://apihub.kma.go.kr/  → 마이페이지 > 인증키 관리
KMA_APIHUB_KEY=
