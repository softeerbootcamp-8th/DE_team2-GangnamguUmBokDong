#!/usr/bin/env bash
# 상시 EC2 부팅 스크립트.
#
# 여기서는 "머신을 준비"만 하고 컨테이너는 띄우지 않는다. user_data는 최초 부팅에만
# 실행되고 로그도 /var/log/cloud-init-output.log에만 남아 디버깅이 어렵다 — 첫
# `uv sync`가 실패하면 원인 파악이 곤란하다. 기동은 make deploy-* 타겟으로 사람이 한다.
#
# 시크릿을 여기에 절대 넣지 말 것. user_data는 인스턴스 메타데이터로 노출된다.
set -euxo pipefail

dnf update -y
# make: Makefile의 deploy-* 타겟 실행용
dnf install -y docker git jq make

# docker compose v2 플러그인 (dnf 패키지로는 안 들어온다)
DOCKER_CLI_PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$DOCKER_CLI_PLUGINS"
curl -fsSL "https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-aarch64" \
  -o "$DOCKER_CLI_PLUGINS/docker-compose"
chmod +x "$DOCKER_CLI_PLUGINS/docker-compose"

systemctl enable --now docker
usermod -aG docker ec2-user

# swap 4GB. 상시 프로세스가 ~2.1GB이고 그 위에 BashOperator subprocess가
# 프로세스당 400MB~1.2GB로 뜬다 — 8GB에서 OOM Killer가 scheduler를 죽이는 것을 완충한다.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=4096
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p /opt/app
chown ec2-user:ec2-user /opt/app

# 레포 clone은 여기서 하지 않는다. 프라이빗 저장소라 자격증명이 필요한데 user_data에
# 넣으면 메타데이터로 노출된다. SSM 세션으로 접속해 clone한 뒤 make deploy-* 를 쓴다.
cat > /etc/motd <<'MOTD'
${project} 상시 EC2

준비 완료: docker, git, jq, swap 4GB, /opt/app

다음 단계:
  1) cd /opt/app && git clone <repo> .
  2) make deploy-env            # S3에서 설정 내려받아 /opt/app/.env 생성
  3) make deploy-db-bootstrap   # 최초 1회 (DB 3개 + Gold 스키마)
  4) make deploy-up
MOTD
